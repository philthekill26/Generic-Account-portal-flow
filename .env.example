# Default: complete offline simulation, with sample credentials shown on login.
FS_MODE=simulation
BRAND_NAME=YourBrand
PRODUCT_NAME=Pro membership
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Render only: TRUST_PROXY=1. Set PUBLIC_ORIGIN to the exact HTTPS service origin.
TRUST_PROXY=0
# PUBLIC_ORIGIN=https://your-service.onrender.com

# To connect FastSpring: FS_MODE=test and supply ALL values below securely.
# Do not commit .env, API credentials, or a populated data directory.
FS_API_USERNAME=
FS_API_PASSWORD=
FS_SUBSCRIPTION_ID=
FS_ACCOUNT_ID=
CUSTOMER_USERNAME=
CUSTOMER_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Portal passwords must be distinct and at least 12 characters in test mode.
